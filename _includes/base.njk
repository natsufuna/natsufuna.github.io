<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if pageTitle %}{{ pageTitle }} · {% endif %}{{ site.title }}</title>
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<meta name="description" content="{{ description or site.aboutme }}">
<meta property="og:title" content="{{ pageTitle or site.title }}">
<meta property="og:description" content="{{ description or site.aboutme }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:locale" content="ja_JP">
<meta name="twitter:card" content="summary">
<meta name="twitter:site" content="@{{ site.twitter }}">
<meta name="theme-color" content="#e9eff3" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#121821" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/images/icon.png">
<link rel="apple-touch-icon" href="/images/icon-192.png">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700&display=swap">
<link rel="stylesheet" href="/assets/css/style.css">
</head>
<body class="{{ bodyClass }}">
<header class="site-header">
  <a class="site-title" href="/">{{ site.title }}</a>
  <nav class="site-nav">
    <a href="/">top</a>
    <a href="/archive/">archive</a>
    <a href="/about/">about</a>
    <a href="/write/" class="nav-write" hidden>write</a>
  </nav>
</header>

<main class="site-main">
{{ content | safe }}
</main>

<footer class="site-footer">
  <p>{{ site.aboutme }}</p>
  <p>
    <a href="https://twitter.com/{{ site.twitter }}">twitter</a> ·
    <a href="https://github.com/{{ site.github }}">github</a> ·
    <a href="/feed.xml">feed</a>
  </p>
</footer>
<script>
  // この端末で投稿の設定がされていれば「write」を表示する
  try { if (localStorage.getItem("diary.writer.token")) document.querySelector(".nav-write").hidden = false; } catch (e) {}
</script>
</body>
</html>
