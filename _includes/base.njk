<!doctype html>
<html lang="ja" {% if season %}data-season="{{ season }}"{% endif %}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if pageTitle %}{{ pageTitle }} · {% endif %}{{ site.title }}</title>
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<meta name="description" content="{{ description or site.tagline }}">
<meta property="og:title" content="{{ pageTitle or site.title }}">
<meta property="og:description" content="{{ description or site.tagline }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:locale" content="ja_JP">
<meta name="twitter:card" content="summary">
<meta name="twitter:site" content="@{{ site.twitter }}">
<meta name="theme-color" content="#f7f6f2" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#15181d" media="(prefers-color-scheme: dark)">
<link rel="icon" href="/images/icon.png">
<link rel="apple-touch-icon" href="/images/icon-192.png">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Shippori+Mincho:wght@500;600&display=swap">
<link rel="stylesheet" href="/assets/css/style.css">
{% if not season %}
<script type="module">
  import { seasonOf } from "/assets/js/august.js";
  document.documentElement.dataset.season = seasonOf(new Date().getMonth() + 1);
</script>
{% endif %}
</head>
<body class="{{ bodyClass }}">
<div class="sky" aria-hidden="true"></div>
<header class="site-header">
  <a class="site-title" href="/">{{ site.title }}</a>
  <span class="site-tagline">{{ site.tagline }}</span>
  <nav class="site-nav">
    <a href="/">日記</a>
    <a href="/archive/">一覧</a>
    <a href="/about/">about</a>
    <a href="/write/" class="nav-write" hidden>書く</a>
  </nav>
</header>

<main class="site-main">
{{ content | safe }}
</main>

<footer class="site-footer">
  <p>{{ site.aboutme }}</p>
  <p>
    <a href="https://twitter.com/{{ site.twitter }}">twitter</a> ·
    <a href="https://github.com/{{ site.github }}">github</a> ·
    <a href="/feed.xml">feed</a>
  </p>
</footer>
<script>
  // この端末で投稿の設定がされていれば「書く」を表示する
  try { if (localStorage.getItem("diary.writer.token")) document.querySelector(".nav-write").hidden = false; } catch (e) {}
</script>
</body>
</html>
